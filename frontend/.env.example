# Copy to frontend/.env.local (gitignored) and restart `npm run dev`.

# true  = serve the real responses in docs/api-mocks (no backend needed)
# false = call the FastAPI backend through the Vite proxy (/api and /ws -> VITE_API_TARGET)
VITE_USE_MOCKS=true

# Backend the Vite proxy forwards /api and /ws to. Default: your own uvicorn.
# Teammate's backend on the same Wi-Fi: http://<their LAN IP>:8000
# (they run: uvicorn app.main:app --host 0.0.0.0 --port 8000)
VITE_API_TARGET=http://localhost:8000
